# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Translation calls use the quick model, content/CV generation uses the default one.
MODEL_QUICK=claude-haiku-5-5
MODEL_DEFAULT=claude-sonnet-5-5

# --- Trainer voices (MongoDB Atlas free tier is enough) ---
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=yayindasin
MAX_VOICE_MB=15

# --- Access ---
# Same value goes into app/www/config.js (APP_KEY). Not a real secret: it only filters casual abuse.
APP_KEY=change-me-app-key
# Give this only to trainers. They type it in Profil > Eğitmen girişi to upload narrations for all students.
TRAINER_KEY=change-me-long-random-trainer-key

# Capacitor origins (Android: https://localhost, iOS: capacitor://localhost). Add your web URL if you also host a PWA.
CORS_ORIGINS=capacitor://localhost,https://localhost,http://localhost

# --- Limits per IP ---
AI_PER_MINUTE=30
AI_PER_DAY=400
